{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src", "tests", "e2e", "scripts", "vitest.config.ts", "vite.config.ts", "playwright.config.ts"],
  "exclude": ["src/renderer", "tests/renderer"]
}
