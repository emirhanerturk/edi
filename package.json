{
  "name": "edi",
  "version": "0.1.0",
  "private": true,
  "description": "Git-aware terminal manager for multi-repo work",
  "type": "module",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup-native.mjs",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.main.json && vite build",
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.renderer.json",
    "icon": "electron scripts/make-icon.mjs"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.4.1",
    "jsdom": "^31.0.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  }
}
