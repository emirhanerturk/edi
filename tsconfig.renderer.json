{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client"],
    "noEmit": true,
    "paths": { "monaco-esm/*": ["./node_modules/monaco-editor/esm/vs/*"] }
  },
  "include": ["src/renderer", "tests/renderer"]
}
