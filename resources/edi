#!/bin/sh
# edi [folder]: opens the folder in edi. If edi is already open, the same window switches to it
# (the new instance hits the single-instance lock and hands the folder to the open one).
app="${EDI_APP:-/Applications/edi.app}"

if [ "$#" -gt 1 ]; then
  echo 'usage: edi [folder]' >&2
  exit 2
fi
if [ "$#" -eq 0 ]; then
  exec open -a "$app"
fi
if ! dir=$(CDPATH= cd -- "$1" 2>/dev/null && pwd -P) || [ ! -d "$1" ]; then
  echo "edi: not a folder: $1" >&2
  exit 1
fi
# One piece (`--open=<path>`): Chromium may reorder the second instance's arguments.
exec open -n -a "$app" --args "--open=$dir"
