#!/bin/sh
# Claude Code status line bridge: on every status update Claude Code passes this command the
# session info as JSON on stdin. Only the usage limits (`rate_limits`: 5-hour and weekly percent
# and reset time) are written to the file edi reads; the rest of the session is not written.
# Nothing is printed to the status line. No network access.
file=${EDI_USAGE_FILE:-"$HOME/Library/Application Support/edi/claude-usage.json"}
limits=$(/usr/bin/plutil -extract rate_limits json -o - - 2>/dev/null) || exit 0
mkdir -p "$(dirname "$file")" 2>/dev/null || exit 0
tmp="$file.$$"
# Never let a half-written file be read: write to a temp file first, then move it into place in one step.
if printf '%s' "$limits" > "$tmp" 2>/dev/null; then
  mv -f "$tmp" "$file" 2>/dev/null || rm -f "$tmp"
fi
exit 0
